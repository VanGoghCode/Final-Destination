# ============================================
# Final Destination — Environment Variables
# Copy to .env.local and fill in your values
# ============================================

# REQUIRED — AI Features
# Get your key from: https://api.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# ============================================
# OPTIONAL — Google Sheets Integration
# For tracking job applications in Google Sheets
# ============================================
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=

# ============================================
# OPTIONAL — Job Scraping Configuration
# ============================================
# Comma-separated roles to include (defaults shown)
TARGET_ROLES=software engineer,cloud architect,devops,backend,frontend,full stack,data scientist,ml engineer,ai engineer,sre

# Comma-separated keywords to exclude (defaults shown)
EXCLUDED_KEYWORDS=director,vp,sales,senior director,principal,15+ years

# Scraping performance tuning
CHUNK_SIZE=200
TOP_CHUNK_SIZE=20
REGULAR_CHUNK_SIZE=180
SCRAPE_INTERVAL_MINUTES=30

# ============================================
# OPTIONAL — Upstash Redis (for Vercel deployment)
# Required only if deploying to Vercel and want to persist data
# Get from: https://console.upstash.com/
# ============================================
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ============================================
# OPTIONAL — Google Service Account (local dev)
# File path to service account JSON key
# ============================================
GOOGLE_APPLICATION_CREDENTIALS=

# ============================================
# OPTIONAL — Notifications
# ============================================
NOTIFICATION_EMAIL=
AWS_REGION=us-west-2
