# ============================================
# Final Destination — Environment Variables
# Copy to .env.local and fill in your values
# ============================================

# AI — configure at least one provider, or enter a key in the app sidebar.
# OpenAI Luna: https://platform.openai.com/api-keys
# Set AI_PROVIDER=openai to select Luna when both providers are configured.
# An OpenAI-only installation selects Luna automatically.
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-6-luna

# DeepSeek (existing default when both keys are available)
# Get your key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ============================================
# OPTIONAL — Upstash Redis (cloud data sync)
# Syncs profiles, templates, job queue across devices.
# Without this: data stays in browser localStorage (works fine).
# Get free tier from: https://console.upstash.com/
# ============================================
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ============================================
# OPTIONAL — Google Sheets Application Tracking
# To log job applications directly to your personal Google Sheet.
# 1. Create a Google Cloud project and enable Sheets API
# 2. Create a Service Account and download the JSON key
# 3. Share your sheet with the service account email
# 4. Stringify the JSON key to a single line and paste below
# ============================================
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=

# ============================================
# REQUIRED — App Access
# Protects private data, mutations, AI generation, and queue processing.
# Set a strong random value; enter it as App access key in the sidebar and extension.
# Requests use x-api-key or Authorization: Bearer. Unconfigured access fails closed.
# ============================================
ADMIN_API_KEY=
# Optional Vercel cron credential; accepted only by /api/cron/process-queue.
# CRON_SECRET=

# ============================================
# OPTIONAL — Job Scraping Configuration
# All have sensible defaults shown below.
# ============================================
# TARGET_ROLES=software engineer,cloud architect,devops
# EXCLUDED_KEYWORDS=director,vp,sales,senior director
# CHUNK_SIZE=200
# SCRAPE_INTERVAL_MINUTES=30

# ============================================
# OPTIONAL — Expanded ATS Company Scraping
# Automatically scrapes extra companies discovered from job-board-aggregator.
# Set to number of extra companies to scrape per platform per run (0 to disable).
# With expanded lists loaded: 2,374 Greenhouse + 1,388 Lever + 2,346 Ashby companies.
# Run `npm run validate-companies` to refresh the validated company list.
# ============================================
# EXPANDED_SCRAPE_MAX=200
# SCRAPE_TIME_BUDGET_MS=45000
