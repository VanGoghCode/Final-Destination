# PII Protection — NEVER commit user data

# User resume/cover letter templates (contain real personal data)
*.tex
!**/README*.tex

# User data exports and backups
*.json.bak
data/export*.json
data/backup*.json

# Local user storage dumps
storage-dump*.json
user-data*.json

# PII patterns — catch accidental commits
*resume*.tex
*cover*letter*.tex
*master*context*.txt

# --- Original gitignore below ---

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# GCP credentials
final-destination-484619-4e905e82893c.json

# Large data files
/data/*.xlsx
/data/*.csv
.env*.local
